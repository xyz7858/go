import heapq

goal = (
    (1, 2, 3),
    (4, 5, 6),
    (7, 8, 0)
)

goal_pos = {}

for i in range(3):
    for j in range(3):
        goal_pos[goal[i][j]] = (i, j)


def heuristic(state):
    distance = 0

    for i in range(3):
        for j in range(3):
            value = state[i][j]

            if value != 0:
                x, y = goal_pos[value]
                distance += abs(i - x) + abs(j - y)

    return distance


def print_state(state):
    for row in state:
        print(row)


def neighbors(state):
    state = [list(r) for r in state]

    for i in range(3):
        for j in range(3):
            if state[i][j] == 0:
                x, y = i, j

    moves = [
        (-1, 0),
        (1, 0),
        (0, -1),
        (0, 1)
    ]

    result = []

    for dx, dy in moves:
        nx = x + dx
        ny = y + dy

        if 0 <= nx < 3 and 0 <= ny < 3:
            new_state = [row[:] for row in state]

            new_state[x][y], new_state[nx][ny] = \
                new_state[nx][ny], new_state[x][y]

            result.append(tuple(tuple(r) for r in new_state))

    return result


def astar(start):
    pq = []

    heapq.heappush(
        pq,
        (heuristic(start), 0, start)
    )

    visited = set()
    step = 1

    while pq:
        f, g, current = heapq.heappop(pq)

        if current in visited:
            continue

        visited.add(current)

    
        print("STEP", step)
        

        print("\nCurrent State:")
        print_state(current)

        print("\ng =", g)
        print("h =", heuristic(current))
        print("f =", f)

        if current == goal:
            print("\nGoal Reached!")
            return

        print("\nGenerated Child States:\n")

        for child in neighbors(current):
            if child not in visited:
                new_g = g + 1
                new_h = heuristic(child)
                new_f = new_g + new_h

                print_state(child)

                print(
                    "g =", new_g,
                    "h =", new_h,
                    "f =", new_f
                )

                print("-----------------------")

                heapq.heappush(
                    pq,
                    (new_f, new_g, child)
                )

        print("Next state selected will have minimum f-value.")

        step += 1


start = (
    (1, 2, 3),
    (4, 0, 6),
    (7, 5, 8)
)

astar(start)
